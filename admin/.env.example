# Vastora Tech Admin Dashboard Environment Configuration

# Backend API Endpoint
VITE_APP_API_BASE_URL=https://api.vastoratech.com/api

# Admin Domain Configuration
VITE_APP_ADMIN_DOMAIN=admin.vastoratech.com

# Cloudinary Media Configuration
VITE_APP_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your-cloud-name/image/upload
VITE_APP_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_APP_CLOUD_NAME=your_cloud_name

# Security & Encryption Key (Must match backend ENCRYPT_PASSWORD)
VITE_APP_ENCRYPT_PASSWORD=your_encryption_password_here

# Demo Mode Flag (Set to "false" for full operational admin mode)
VITE_APP_DISABLE_FOR_DEMO=false

