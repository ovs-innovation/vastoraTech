# Vastora Tech Backend Environment Configuration

PORT=8081
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vastora_tech?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here
JWT_SECRET_FOR_VERIFY=your_jwt_verify_secret_key_here
ENCRYPT_PASSWORD=your_encryption_password_here

# Payment Gateway Configuration
STRIPE_KEY=your_stripe_secret_key_here
MAX_AMOUNT=50000
MIN_AMOUNT=10
AMOUNT_STEP=1
CURRENCY=usd
STRIPE_PAYMENT_DESCRIPTION="This is Vastora Tech payment with Stripe!"

# Email Notification Service
SERVICE=gmail
EMAIL_USER=support@vastoratech.com
EMAIL_PASS=your_email_app_password_here
HOST=smtp.gmail.com
EMAIL_PORT=465

# Domain & Application URLs
STORE_URL=https://vastoratech.com
ADMIN_URL=https://admin.vastoratech.com

